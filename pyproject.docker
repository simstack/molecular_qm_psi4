# Container-only install manifest (dual-use capability package).
# Host: no pyproject.toml — flat tree under simstack-model for create_*_table.
# Image: Dockerfile copies this to pyproject.toml, then `uv pip install .`
# (hatch force-include + deps from git via [tool.uv.sources]).
[project]
name = "molecular_qm_psi4"
version = "0.1.0"
description = "Psi4 capabilities for molecular quantum mechanics within the Simstack framework"
readme = "README.md"
requires-python = ">=3.12"
license = { text = "MIT" }
authors = [
  { name = "Wolfgang Wenzel", email = "wolfgang.wenzel@kit.edu" }
]
dependencies = [
    "molecular_qm_models",
    "molecular_qm_util",
    "simstack",
]

[project.entry-points."simstack.modules"]
molecular_qm_psi4 = "molecular_qm_psi4"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.metadata]
allow-direct-references = true

# Flat checkout root → nested import package in the wheel.
[tool.hatch.build.targets.wheel]
bypass-selection = true

[tool.hatch.build.targets.wheel.force-include]
"__init__.py" = "molecular_qm_psi4/__init__.py"
"nodes" = "molecular_qm_psi4/nodes"
"models" = "molecular_qm_psi4/models"
"util" = "molecular_qm_psi4/util"
"scripts" = "molecular_qm_psi4/scripts"
"testing" = "molecular_qm_psi4/testing"
"data" = "molecular_qm_psi4/data"

[tool.uv.sources]
molecular_qm_models = { git = "https://github.com/simstack/molecular_qm_models.git", rev= "feature-psi4" }
molecular_qm_util = { git = "https://github.com/simstack/molecular_qm_util.git", rev = "develop-ww" }
simstack = { git = "https://github.com/simstack/simstack.git", rev = "fix-git-pull" }

[tool.uv]
override-dependencies = [
    "molecular_qm_models @ git+https://github.com/simstack/molecular_qm_models.git@feature-psi4",
    "molecular_qm_util @ git+https://github.com/simstack/molecular_qm_util.git@develop-ww",
    "simstack @ git+https://github.com/simstack/simstack.git@fix-git-pull",
]
