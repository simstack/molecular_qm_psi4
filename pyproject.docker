# Container-only install manifest.
# Image: Dockerfile copies this to pyproject.toml, then `uv pip install .`
# so dependency packages are resolved from git via [tool.uv.sources].
[project]
name = "molecular_qm_psi4"
dynamic = ["version"]
description = "Psi4 capabilities for molecular quantum mechanics within the Simstack framework"
readme = "README.md"
requires-python = ">=3.12"
license = { text = "MIT" }
authors = [
  { name = "Wolfgang Wenzel", email = "wolfgang.wenzel@kit.edu" }
]
dependencies = [
    "molecular_qm_models",
    "molecular_qm_util",
    "molecular_qm_dftb",
    "simstack",
]

[project.entry-points."simstack.modules"]
molecular_qm_psi4 = "molecular_qm_psi4"

[build-system]
requires = ["hatchling", "hatch-vcs"]
build-backend = "hatchling.build"

[tool.hatch.version]
source = "vcs"
fallback-version = "0.1.0"

[tool.hatch.version.raw-options]
version_scheme = "guess-next-dev"
local_scheme = "no-local-version"
fallback_version = "0.1.0"

[tool.hatch.build.hooks.vcs]
version-file = "_version.py"

[tool.hatch.metadata]
allow-direct-references = true

# Repo root is the package when checked out as the molecular_qm_psi4 submodule.
[tool.hatch.build.targets.wheel]
bypass-selection = true

[tool.hatch.build.targets.wheel.force-include]
"__init__.py" = "molecular_qm_psi4/__init__.py"
"_version.py" = "molecular_qm_psi4/_version.py"
"nodes" = "molecular_qm_psi4/nodes"
"models" = "molecular_qm_psi4/models"
"util" = "molecular_qm_psi4/util"
"scripts" = "molecular_qm_psi4/scripts"
"testing" = "molecular_qm_psi4/testing"
"data" = "molecular_qm_psi4/data"

[tool.uv.sources]
molecular_qm_models = { git = "https://github.com/simstack/molecular_qm_models.git" }
molecular_qm_util = { git = "https://github.com/simstack/molecular_qm_util.git" }
molecular_qm_dftb = { git = "https://github.com/simstack/molecular_qm_dftb.git" }

simstack = { git = "https://github.com/simstack/simstack.git", rev = "fix-node-submission-logic" }

[tool.uv]
override-dependencies = [
    "molecular_qm_models @ git+https://github.com/simstack/molecular_qm_models.git",
    "molecular_qm_util @ git+https://github.com/simstack/molecular_qm_util.git",
    "simstack @ git+https://github.com/simstack/simstack.git@fix-node-submission-logic",
    # conda-forge openbabel provides the Python module; pip's openbabel-wheel
    # overlays it and breaks `from openbabel import pybel` in this image.
    "openbabel-wheel; sys_platform == 'never'",
]

[tool.pytest.ini_options]
asyncio_default_fixture_loop_scope = "session"
asyncio_default_test_loop_scope = "session"
